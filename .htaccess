# OD9 Public Directory Rewrites
RewriteEngine On

# No auto-generated directory listings. Without this Apache indexed every
# directory lacking an index file — /api/, /api/v1/, /api/drip/, /api/discord/,
# /includes/, /library/, /email-templates/ and /images/ all served a browsable
# "Index of" page (found 2026-08-11). That is structure enumeration: it exposes
# every include and endpoint filename to anyone who asks.
#
# It was NOT a content bypass — library/.htaccess already 403s the gated
# Architect/Pioneer/Benefactor tiers, and that stays the mechanism for gating.
# This only stops Apache advertising what is on disk.
#
# Directories with a real index.php/index.html are unaffected; they keep serving it.
Options -Indexes

# Transparent WebP: if the browser advertises image/webp AND a same-named
# .webp twin exists on disk, serve it in place of the .jpg/.png. The HTML
# keeps requesting the original URL, so there are zero markup changes and
# non-supporting clients (and missing twins) fall through to the original.
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME} (.+)\.(jpe?g|png)$
RewriteCond %1\.webp -f
RewriteRule (.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=webp:1,L]
<IfModule mod_headers.c>
  # Tell caches the response varies on Accept so a webp isn't served to a
  # non-webp client (or vice-versa) from a shared cache.
  Header append Vary Accept env=webp
</IfModule>

# The show rundown (a local file:// page — tools/build_rundown.py in the bot
# repo) polls the call-in door's state, callin/state.json, which the bot
# publishes. A public read: any origin may fetch it, and nothing caches it.
<IfModule mod_headers.c>
  <Files "state.json">
    Header set Access-Control-Allow-Origin "*"
    Header set Cache-Control "no-store"
  </Files>
</IfModule>

# Serve the filesystem-generated sitemap at the conventional /sitemap.xml
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Clean URL: /wake-up -> wake-up.php
RewriteRule ^wake-up$ wake-up.php [L,QSA]

# Clean URL: /join -> join.php
RewriteRule ^join$ join.php [L,QSA]

# Clean URL: /subscribe -> subscribe.php (API endpoint)
RewriteRule ^subscribe$ subscribe.php [L,QSA]

# Clean URL: /atlas -> atlas.php (the living manifesto map)
# An internal rewrite, not a redirect, so the clean URL stays in the address
# bar and QSA preserves ?live=1 (the follow-along door fired by go-live
# announces). Added 2026-08-22 after the bare /atlas 404'd in a published
# YouTube description.
RewriteRule ^atlas$ atlas.php [L,QSA]

# /tour -> the Atlas with a guided flight already running, for an end card
# somebody reads off a screen. Defaults to arc 1, "The Information Problem":
# six stops, about forty seconds. /tour/arc3 and /tour/all pick another route,
# and the shape (arc + digit) rather than a list of ids means adding arc5 needs
# no edit here.
#
# A REDIRECT, unlike /atlas directly above it, and the difference is not
# stylistic. The tour is started by JavaScript reading location.search, and an
# internal rewrite never touches the browser's URL — the query would reach PHP
# and the browser would still see none, so the clean link would land on a map
# that sits there doing nothing. atlas.php reads only ?og, so there is no
# server-side channel to carry it either. 302 rather than 301: the default arc
# should be changeable without fighting a permanent redirect cached in every
# browser that ever followed the card.
# The base comes from REQUEST_URI rather than being written down, because a
# relative substitution on an external redirect resolves against the FILESYSTEM
# path in a per-directory context: the first working version of this rule sent
# browsers to http://localhost/C:/xampp/htdocs/od9/atlas. %1 is whatever sits in
# front of /tour — empty on prod, /od9 on the local XAMPP copy — so one rule is
# right in both places without a RewriteBase that could only be right in one.
RewriteCond %{REQUEST_URI} ^(.*)/tour/?$
RewriteRule ^tour/?$ %1/atlas?tour=arc1 [R=302,L,QSA]
RewriteCond %{REQUEST_URI} ^(.*)/tour/(?:all|arc[1-9])/?$
RewriteRule ^tour/(all|arc[1-9])/?$ %1/atlas?tour=$1 [R=302,L,QSA]

# /epk -> the platform-served press kit. A REDIRECT this time, not an internal
# rewrite like /atlas: the press kit is not a file in this docroot at all — it
# is rendered by the F.R.E.S.H. platform from the od9 tenant's epk_profiles row
# (Phase 24B), and od9.freshthaplatform.com/epk is its one canonical home.
# 302, not 301: when OD9 becomes a full FTP tenant (the consolidation plan) or
# the EPK moves under this domain, a cached 301 in every browser and crawler
# that ever followed it would fight the change. Trailing-slash tolerant.
RewriteRule ^epk/?$ https://od9.freshthaplatform.com/epk [R=302,L]

# Dotfiles - nothing whose NAME starts with a dot may be served. Covers the
# eight .htaccess files in this tree and .user.ini. ACME is unaffected: the
# challenge files inside .well-known/ have ordinary names, and this matches on
# the basename.
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# Backup and editor droppings, matched by SHAPE not by name.
#
# On 2026-08-31 this docroot held 23 of them and had no rule at all. Four were
# confirmed serving 200 with their PHP source to anyone who asked - including
# dashboard/includes/auth.php.bak-20260615-012330 - and a dummy file proved
# api/drip/webhook.php.bak-pre-patch-20260501-025438 had been fetchable since
# May. The seven secrets.config.php.bak-* copies did NOT leak, but only because
# they happened to be mode 600 and Apache could not read them; that is luck,
# not a control. All 23 are archived outside the webroot and deleted.
#
# Deliberately NARROW: .md, .txt and .json are NOT blocked, because this site
# publishes 70, 33 and 10 of them respectively. Validated against the real
# 1,014-file docroot listing - 10 files match, all .htaccess/.user.ini/error_log,
# and no content of any kind.
# `sql` is in the list because the repo now carries database/schema.prod.sql for
# schema-usage-lint. The deploy excludes database/ so it should never reach the
# webroot at all — this is the second layer, since od9 serves no .sql of any kind.
<FilesMatch "(?i)^error_log$|\.(bak|backup|old|orig|save|swp|swo|tmp|dist|inc|sql)([._-][^/]*)?$|~$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
