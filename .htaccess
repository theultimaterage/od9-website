# OD9 Public Directory Rewrites
RewriteEngine On

# No auto-generated directory listings. Without this Apache indexed every
# directory lacking an index file — /api/, /api/v1/, /api/drip/, /api/discord/,
# /includes/, /library/, /email-templates/ and /images/ all served a browsable
# "Index of" page (found 2026-08-11). That is structure enumeration: it exposes
# every include and endpoint filename to anyone who asks.
#
# It was NOT a content bypass — library/.htaccess already 403s the gated
# Architect/Pioneer/Benefactor tiers, and that stays the mechanism for gating.
# This only stops Apache advertising what is on disk.
#
# Directories with a real index.php/index.html are unaffected; they keep serving it.
Options -Indexes

# Transparent WebP: if the browser advertises image/webp AND a same-named
# .webp twin exists on disk, serve it in place of the .jpg/.png. The HTML
# keeps requesting the original URL, so there are zero markup changes and
# non-supporting clients (and missing twins) fall through to the original.
RewriteCond %{HTTP_ACCEPT} image/webp
RewriteCond %{REQUEST_FILENAME} (.+)\.(jpe?g|png)$
RewriteCond %1\.webp -f
RewriteRule (.+)\.(jpe?g|png)$ $1.webp [T=image/webp,E=webp:1,L]
<IfModule mod_headers.c>
  # Tell caches the response varies on Accept so a webp isn't served to a
  # non-webp client (or vice-versa) from a shared cache.
  Header append Vary Accept env=webp
</IfModule>

# Serve the filesystem-generated sitemap at the conventional /sitemap.xml
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Clean URL: /wake-up -> wake-up.php
RewriteRule ^wake-up$ wake-up.php [L,QSA]

# Clean URL: /join -> join.php
RewriteRule ^join$ join.php [L,QSA]

# Clean URL: /subscribe -> subscribe.php (API endpoint)
RewriteRule ^subscribe$ subscribe.php [L,QSA]

# Clean URL: /atlas -> atlas.php (the living manifesto map)
# An internal rewrite, not a redirect, so the clean URL stays in the address
# bar and QSA preserves ?live=1 (the follow-along door fired by go-live
# announces). Added 2026-08-22 after the bare /atlas 404'd in a published
# YouTube description.
RewriteRule ^atlas$ atlas.php [L,QSA]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
